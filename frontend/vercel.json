      "destination": "https://akshaynhcm--evt-clip-v2-production-web.modal.run/api/:path*"
    },
    {
      "source": "/example-assets/:path*",
      "destination": "https://akshaynhcm--evt-clip-v2-production-web.modal.run/example-assets/:path*"
    },
    {
      "source": "/health",
