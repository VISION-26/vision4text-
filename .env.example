# Local FastAPI development only. Modal production values are set in modal_deploy.py
# plus the Modal Secret `evt-clip-v2-secrets`.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./evtclip.db
JWT_SECRET=replace-with-a-long-random-secret
EVIDENCE_SIGNING_SECRET=replace-with-a-different-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=EVT-CLIP Administrator
DEMO_MODE=false
MODEL_DIR=/models/production
MODAL_JOB_QUEUE=false
UPLOAD_DIR=uploads
REPORT_DIR=reports
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Keep false for an Internet-facing production deployment.
ALLOW_PUBLIC_REGISTRATION=false

